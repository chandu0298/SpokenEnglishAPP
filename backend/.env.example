# ============================================================
# SpokenEnglishAPP — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values

# -- Groq --
GROQ_API_KEY=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

# -- Neon PostgreSQL --
DATABASE_URL=postgresql+asyncpg://user:password@hostname/dbname

# -- Upstash Redis --
UPSTASH_REDIS_URL=https://your-upstash-redis-url
UPSTASH_REDIS_TOKEN=your_upstash_redis_token

# -- Firebase (Auth) --
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase_service_account.json

# -- Razorpay (Payments) --
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# -- App Config --
APP_ENV=development
CORS_ORIGINS=http://localhost:8081,exp://localhost:8081
JWT_SECRET=your_jwt_secret_here

# -- Plans --
PRO_PLAN_AMOUNT=19900   # Amount in paise = ₹199
