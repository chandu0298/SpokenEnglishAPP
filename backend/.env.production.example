# SpokenEnglishAPP - Production Environment Variables Template
# Copy this to .env.production on your server and fill in the values.

# General
APP_ENV=production
CORS_ORIGINS=https://yourdomain.com,exp://yourdomain.com

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require

# Groq (AI: Coach Priya, Grammar, Whisper STT)
GROQ_API_KEY=gsk_prod_...

# Upstash Redis (Memory & Limits)
UPSTASH_REDIS_URL=https://prod-redis.upstash.io
UPSTASH_REDIS_TOKEN=...

# Razorpay (Payments)
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# Google Cloud (High-Fidelity TTS)
# Path to your Google Cloud Service Account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./google_cloud_credentials.json

# Firebase Admin
# Path to your Firebase Service Account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase_service_account.json
